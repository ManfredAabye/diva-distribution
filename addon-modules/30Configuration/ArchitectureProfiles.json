{
  "Profiles": {
    "Standalone": {
      "Name": "Standalone",
      "Description": "Single instance without Hypergrid connectivity - Best for private, local testing",
      "IncludeArchitecture": "config-include/Standalone.ini",
      "ConfigureFiles": [
        "OpenSim.ini",
        "Regions/RegionConfig.ini",
        "config-include/Standalone.ini",
        "config-include/StandaloneCommon.ini"
      ],
      "RequiresHypergrid": false,
      "RequiresRobust": false,
      "EnableWifi": true,
      "Ports": {
        "DefaultHttp": 9000,
        "DefaultHttps": 9001
      },
      "PhysicsEngine": {
        "Engine": "BulletSim",
        "Meshing": "Meshmerizer",
        "DisableUbODE": true
      },
      "ScriptEngine": {
        "DefaultEngine": "YEngine",
        "YEngineEnabled": true,
        "XEngineEnabled": false
      }
    },
    "StandaloneHypergrid": {
      "Name": "StandaloneHypergrid",
      "Description": "Single instance with Hypergrid connectivity - Recommended for Diva Distribution",
      "IncludeArchitecture": "config-include/StandaloneHypergrid.ini",
      "ConfigureFiles": [
        "OpenSim.ini",
        "Regions/RegionConfig.ini",
        "config-include/StandaloneHypergrid.ini",
        "config-include/StandaloneCommon.ini",
        "config-include/MyWorld.ini"
      ],
      "RequiresHypergrid": true,
      "RequiresRobust": false,
      "EnableWifi": true,
      "EnableDivaIntegration": true,
      "Ports": {
        "DefaultHttp": 9000,
        "DefaultHttps": 9001
      },
      "DivaSettings": {
        "EnableAgentPreferencesService": true,
        "AsyncCallMethod": "SmartThreadPool",
        "UseAsyncWhenPossible": false
      },
      "PhysicsEngine": {
        "Engine": "BulletSim",
        "Meshing": "Meshmerizer",
        "DisableUbODE": true
      },
      "ScriptEngine": {
        "DefaultEngine": "YEngine",
        "YEngineEnabled": true,
        "XEngineEnabled": false
      }
    },
    "Grid": {
      "Name": "Grid",
      "Description": "Multi-instance grid setup without Hypergrid - Best for large private grids",
      "IncludeArchitecture": "config-include/Grid.ini",
      "ConfigureFiles": [
        "OpenSim.ini",
        "Robust.ini",
        "Regions/RegionConfig.ini",
        "config-include/Grid.ini",
        "config-include/GridCommon.ini"
      ],
      "RequiresHypergrid": false,
      "RequiresRobust": true,
      "EnableWifi": false,
      "Ports": {
        "DefaultHttp": 8002,
        "DefaultHttps": 8003,
        "RegionHttp": 9000
      },
      "GridService": {
        "DefaultRegionFlags": "DefaultRegion, FallbackRegion"
      },
      "PhysicsEngine": {
        "Engine": "BulletSim",
        "Meshing": "Meshmerizer",
        "DisableUbODE": true
      },
      "ScriptEngine": {
        "DefaultEngine": "YEngine",
        "YEngineEnabled": true,
        "XEngineEnabled": false
      }
    },
    "GridHypergrid": {
      "Name": "GridHypergrid",
      "Description": "Multi-instance grid with Hypergrid connectivity - Most flexible but complex setup",
      "IncludeArchitecture": "config-include/GridHypergrid.ini",
      "ConfigureFiles": [
        "OpenSim.ini",
        "Robust.HG.ini",
        "Regions/RegionConfig.ini",
        "config-include/GridHypergrid.ini",
        "config-include/GridCommon.ini"
      ],
      "RequiresHypergrid": true,
      "RequiresRobust": true,
      "EnableWifi": true,
      "Ports": {
        "DefaultHttp": 8002,
        "DefaultHttps": 8003,
        "RegionHttp": 9000
      },
      "GridService": {
        "DefaultRegionFlags": "DefaultRegion, DefaultHGRegion, FallbackRegion"
      },
      "PhysicsEngine": {
        "Engine": "BulletSim",
        "Meshing": "Meshmerizer",
        "DisableUbODE": true
      },
      "ScriptEngine": {
        "DefaultEngine": "YEngine",
        "YEngineEnabled": true,
        "XEngineEnabled": false
      }
    }
  },
  "TestScenarios": {
    "Standalone": {
      "WorldName": "Test Standalone World",
      "AdminFirstName": "Test",
      "AdminLastName": "Admin",
      "AdminPassword": "test123",
      "DbType": "SQLite"
    },
    "StandaloneHypergrid": {
      "WorldName": "Test Hypergrid World",
      "AdminFirstName": "HG",
      "AdminLastName": "Admin",
      "AdminPassword": "hgtest123",
      "DbType": "SQLite"
    },
    "Grid": {
      "WorldName": "Test Grid",
      "AdminFirstName": "Grid",
      "AdminLastName": "Admin",
      "AdminPassword": "grid123",
      "DbType": "MySQL"
    },
    "GridHypergrid": {
      "WorldName": "Test Grid HG",
      "AdminFirstName": "GridHG",
      "AdminLastName": "Admin",
      "AdminPassword": "gridhg123",
      "DbType": "MySQL"
    }
  },
  "DefaultEngineSettings": {
    "PhysicsEngine": {
      "Engine": "BulletSim",
      "Meshing": "Meshmerizer",
      "DisableUbODE": true,
      "Comment": "BulletSim aktiviert, ubODE deaktiviert"
    },
    "ScriptEngine": {
      "DefaultEngine": "YEngine",
      "YEngineEnabled": true,
      "XEngineEnabled": false,
      "MinTimerInterval": 0.05,
      "ScriptDistanceLimitFactor": 20,
      "DeleteScriptsOnStartup": false,
      "Comment": "YEngine aktiviert, XEngine deaktiviert"
    },
    "OSSL": {
      "Enabled": true,
      "AllowOSFunctions": true,
      "AllowMODFunctions": true,
      "AllowLightShareFunctions": true,
      "OSFunctionThreatLevel": "High",
      "PermissionErrorToOwner": false,
      "Comment": "OSSL-Funktionen aktiviert mit ThreatLevel High"
    },
    "Network": {
      "HttpBodyMaxLenMAX": 16384,
      "Comment": "HTTP-Filter muss für localhost konfiguriert werden"
    }
  }
}
