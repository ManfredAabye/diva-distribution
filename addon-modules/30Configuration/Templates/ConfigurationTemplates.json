{
  "ConfigurationTemplates": {
    "Description": "OpenSim Configuration Templates - Generates configuration files without comments from JSON definitions",
    "Version": "2.0.0",
    "LastModified": "2025-11-13",
    
    "Architectures": {
      "Standalone": {
        "Name": "Standalone",
        "Description": "Single server instance without Hypergrid connectivity",
        "RequiresRobust": false,
        "RequiresHypergrid": false,
        "DefaultRegions": ["DefaultRegion"],
        "ConfigFiles": [
          "OpenSim.ini",
          "config-include/Standalone.ini",
          "config-include/StandaloneCommon.ini",
          "config-include/osslEnable.ini",
          "config-include/storage/SQLiteStandalone.ini",
          "Regions/DefaultRegion.ini"
        ]
      },
      
      "StandaloneHypergrid": {
        "Name": "StandaloneHypergrid",
        "Description": "Single server instance with Hypergrid connectivity",
        "RequiresRobust": false,
        "RequiresHypergrid": true,
        "DefaultRegions": ["DefaultRegion"],
        "ConfigFiles": [
          "OpenSim.ini",
          "config-include/StandaloneHypergrid.ini",
          "config-include/StandaloneCommon.ini",
          "config-include/osslEnable.ini",
          "config-include/storage/SQLiteStandalone.ini",
          "Regions/DefaultRegion.ini",
          "Wifi.ini"
        ]
      },
      
      "Grid": {
        "Name": "Grid",
        "Description": "Multi-region grid with separate Robust server",
        "RequiresRobust": true,
        "RequiresHypergrid": false,
        "DefaultRegions": ["DefaultRegion", "FallbackRegion"],
        "ConfigFiles": [
          "OpenSim.ini",
          "Robust.ini",
          "config-include/Grid.ini",
          "config-include/GridCommon.ini",
          "config-include/osslEnable.ini",
          "config-include/storage/SQLiteStandalone.ini",
          "Regions/DefaultRegion.ini",
          "Regions/FallbackRegion.ini"
        ]
      },
      
      "GridHypergrid": {
        "Name": "GridHypergrid",
        "Description": "Multi-region grid with Hypergrid and separate Robust server",
        "RequiresRobust": true,
        "RequiresHypergrid": true,
        "DefaultRegions": ["DefaultRegion", "DefaultHGRegion", "FallbackRegion"],
        "ConfigFiles": [
          "OpenSim.ini",
          "Robust.HG.ini",
          "config-include/GridHypergrid.ini",
          "config-include/GridCommon.ini",
          "config-include/osslEnable.ini",
          "config-include/storage/SQLiteStandalone.ini",
          "Regions/DefaultRegion.ini",
          "Regions/DefaultHGRegion.ini",
          "Regions/FallbackRegion.ini",
          "Wifi.ini"
        ]
      }
    }
  }
}
