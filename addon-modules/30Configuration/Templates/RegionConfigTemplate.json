{
  "RegionConfigTemplate": {
    "Description": "Region configuration template for Regions/*.ini files",
    "DefaultRegion": {
      "RegionName": "${WorldName}",
      "Location": "${BaseLocationX},${BaseLocationY}",
      "InternalAddress": "0.0.0.0",
      "InternalPort": 9000,
      "AllowAlternatePorts": false,
      "ExternalHostName": "${IpAddress}",
      "RegionType": "Mainland",
      "RegionUUID": "GENERATE_NEW_UUID",
      "ScopeID": "00000000-0000-0000-0000-000000000000",
      "SizeX": "${RegionSizeX}",
      "SizeY": "${RegionSizeY}",
      "SizeZ": "${RegionSizeZ}",
      "MaxPrimsPerUser": -1,
      "MaxAgents": 100,
      "NonPhysicalPrimMax": 256,
      "PhysicalPrimMax": 64,
      "ClampPrimSize": false,
      "MaptileStaticUUID": "GENERATE_NEW_UUID"
    },
    
    "FallbackRegion": {
      "RegionName": "FallbackRegion",
      "Location": "${BaseLocationX+1},${BaseLocationY}",
      "InternalAddress": "0.0.0.0",
      "InternalPort": 9001,
      "AllowAlternatePorts": false,
      "ExternalHostName": "${IpAddress}",
      "RegionType": "Mainland",
      "RegionUUID": "GENERATE_NEW_UUID",
      "ScopeID": "00000000-0000-0000-0000-000000000000",
      "SizeX": "512",
      "SizeY": "512",
      "SizeZ": "4096",
      "MaxPrimsPerUser": -1,
      "MaxAgents": 100,
      "MaptileStaticUUID": "GENERATE_NEW_UUID"
    },
    
    "DefaultHGRegion": {
      "RegionName": "DefaultHGRegion",
      "Location": "${BaseLocationX},${BaseLocationY+1}",
      "InternalAddress": "0.0.0.0",
      "InternalPort": 9002,
      "AllowAlternatePorts": false,
      "ExternalHostName": "${IpAddress}",
      "RegionType": "Mainland",
      "RegionUUID": "GENERATE_NEW_UUID",
      "ScopeID": "00000000-0000-0000-0000-000000000000",
      "SizeX": "512",
      "SizeY": "512",
      "SizeZ": "4096",
      "MaxPrimsPerUser": -1,
      "MaxAgents": 100,
      "MaptileStaticUUID": "GENERATE_NEW_UUID"
    }
  }
}
