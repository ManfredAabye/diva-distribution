{
  "StandaloneCommonTemplate": {
    "Description": "StandaloneCommon.ini template - Common services for Standalone mode",
    "Sections": {
      "DatabaseService": {
        "Include-Storage": "config-include/storage/SQLiteStandalone.ini"
      },
      
      "Hypergrid": {
        "HomeURI": "http://${IpAddress}:${HttpPort}",
        "GatekeeperURI": "http://${IpAddress}:${HttpPort}"
      },
      
      "Modules": {
        "AssetServices": "LocalAssetServicesConnector",
        "InventoryServices": "LocalInventoryServicesConnector",
        "NeighbourServices": "LocalNeighbourServicesConnector",
        "AuthenticationServices": "LocalAuthenticationServicesConnector",
        "AuthorizationServices": "LocalAuthorizationServicesConnector",
        "GridServices": "LocalGridServicesConnector",
        "PresenceServices": "LocalPresenceServicesConnector",
        "UserAccountServices": "LocalUserAccountServicesConnector",
        "GridUserServices": "LocalGridUserServicesConnector",
        "SimulationServices": "LocalSimulationConnectorModule",
        "AvatarServices": "LocalAvatarServicesConnector",
        "EntityTransferModule": "BasicEntityTransferModule",
        "InventoryAccessModule": "BasicInventoryAccessModule",
        "LandServices": "LandServicesConnector",
        "FriendsModule": "FriendsModule",
        "MapImageService": "MapImageServiceModule",
        "SearchModule": "BasicSearchModule",
        "MuteListService": "LocalMuteListServicesConnector",
        "EstateServices": "LocalEstateServicesConnector"
      },
      
      "AssetService": {
        "LocalServiceModule": "OpenSim.Services.AssetService.dll:AssetService",
        "StorageProvider": "${AssetDll}",
        "ConnectionString": "${AssetConnectionString}",
        "DefaultAssetLoader": "OpenSim.Framework.AssetLoader.Filesystem.dll",
        "AssetLoaderArgs": "assets/AssetSets.xml"
      },
      
      "InventoryService": {
        "LocalServiceModule": "OpenSim.Services.InventoryService.dll:XInventoryService",
        "StorageProvider": "${InventoryDll}",
        "ConnectionString": "${InventoryConnectionString}"
      },
      
      "GridService": {
        "LocalServiceModule": "OpenSim.Services.GridService.dll:GridService",
        "StorageProvider": "${GridDll}",
        "ConnectionString": "${GridConnectionString}",
        "Region_${WorldName}": "DefaultRegion, FallbackRegion",
        "AllowHypergridMapSearch": "${AllowHypergridMapSearch}"
      },
      
      "PresenceService": {
        "LocalServiceModule": "OpenSim.Services.PresenceService.dll:PresenceService",
        "StorageProvider": "${PresenceDll}",
        "ConnectionString": "${PresenceConnectionString}"
      },
      
      "AuthenticationService": {
        "LocalServiceModule": "OpenSim.Services.AuthenticationService.dll:PasswordAuthenticationService",
        "StorageProvider": "${AuthenticationDll}",
        "ConnectionString": "${AuthenticationConnectionString}"
      },
      
      "UserAccountService": {
        "LocalServiceModule": "OpenSim.Services.UserAccountService.dll:UserAccountService",
        "StorageProvider": "${UserAccountDll}",
        "ConnectionString": "${UserAccountConnectionString}",
        "AuthenticationService": "OpenSim.Services.AuthenticationService.dll:PasswordAuthenticationService",
        "GridUserService": "OpenSim.Services.UserAccountService.dll:GridUserService",
        "CreateDefaultAvatarEntries": "true"
      },
      
      "GridUserService": {
        "LocalServiceModule": "OpenSim.Services.UserAccountService.dll:GridUserService",
        "StorageProvider": "${GridUserDll}",
        "ConnectionString": "${GridUserConnectionString}"
      },
      
      "AvatarService": {
        "LocalServiceModule": "OpenSim.Services.AvatarService.dll:AvatarService",
        "StorageProvider": "${AvatarDll}",
        "ConnectionString": "${AvatarConnectionString}"
      },
      
      "FriendsService": {
        "LocalServiceModule": "OpenSim.Services.FriendsService.dll:FriendsService",
        "StorageProvider": "${FriendsDll}",
        "ConnectionString": "${FriendsConnectionString}"
      },
      
      "EstateService": {
        "LocalServiceModule": "OpenSim.Services.EstateService.dll:EstateDataService",
        "StorageProvider": "${EstateDll}",
        "ConnectionString": "${EstateConnectionString}"
      },
      
      "LibraryService": {
        "LocalServiceModule": "OpenSim.Services.InventoryService.dll:LibraryService",
        "LibraryName": "OpenSim Library",
        "DefaultLibrary": "./inventory/Libraries.xml"
      },
      
      "LoginService": {
        "LocalServiceModule": "OpenSim.Services.LLLoginService.dll:LLLoginService",
        "UserAccountService": "OpenSim.Services.UserAccountService.dll:UserAccountService",
        "GridUserService": "OpenSim.Services.UserAccountService.dll:GridUserService",
        "AuthenticationService": "OpenSim.Services.AuthenticationService.dll:PasswordAuthenticationService",
        "InventoryService": "OpenSim.Services.InventoryService.dll:XInventoryService",
        "AvatarService": "OpenSim.Services.AvatarService.dll:AvatarService",
        "PresenceService": "OpenSim.Services.PresenceService.dll:PresenceService",
        "GridService": "OpenSim.Services.GridService.dll:GridService",
        "SimulationService": "OpenSim.Services.Connectors.dll:SimulationServiceConnector",
        "LibraryService": "OpenSim.Services.InventoryService.dll:LibraryService",
        "FriendsService": "OpenSim.Services.FriendsService.dll:FriendsService",
        "UserAgentService": "OpenSim.Services.HypergridService.dll:UserAgentService",
        "WelcomeMessage": "${WelcomeMessage}",
        "AllowRemoteSetLoginLevel": "false",
        "MapTileURL": "http://${IpAddress}:${HttpPort}",
        "SearchURL": "http://${IpAddress}:${HttpPort}",
        "DestinationGuide": "http://${IpAddress}:${HttpPort}/wifi/loginscreen.html",
        "AvatarPicker": "http://${IpAddress}:${HttpPort}/"
      },
      
      "MapImageService": {
        "LocalServiceModule": "OpenSim.Services.MapImageService.dll:MapImageService",
        "TilesStoragePath": "./maptiles",
        "RefreshTime": "3600"
      },
      
      "Messaging": {
        "OfflineIMService": "OpenSim.Addons.OfflineIM.dll:OfflineIMService"
      },
      
      "Groups": {
        "Enabled": "true",
        "Module": "Groups Module V2",
        "StorageProvider": "${GroupsDll}",
        "ConnectionString": "${GroupsConnectionString}",
        "ServicesConnectorModule": "Groups Local Service Connector",
        "LocalService": "local",
        "GroupsServerURI": "",
        "NoticesEnabled": "true",
        "MessageOnlineUsersOnly": "true",
        "DebugEnabled": "false",
        "XmlRpcServiceReadKey": "1234",
        "XmlRpcServiceWriteKey": "1234"
      },
      
      "UserProfilesService": {
        "LocalServiceModule": "OpenSim.Services.UserProfilesService.dll:UserProfilesService",
        "Enabled": "true",
        "UserAccountService": "OpenSim.Services.UserAccountService.dll:UserAccountService",
        "AuthenticationServiceModule": "OpenSim.Services.AuthenticationService.dll:PasswordAuthenticationService",
        "StorageProvider": "${ProfilesDll}",
        "ConnectionString": "${ProfilesConnectionString}"
      },
      
      "BakedTextureService": {
        "LocalServiceModule": "OpenSim.Server.Handlers.dll:XBakesHandler"
      },
      
      "MuteListService": {
        "LocalServiceModule": "OpenSim.Services.MuteListService.dll:MuteListService",
        "StorageProvider": "${MuteListDll}",
        "ConnectionString": "${MuteListConnectionString}"
      }
    }
  }
}
