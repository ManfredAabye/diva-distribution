msgid "Your account has been created."
msgstr "계정이 생성되었습니다."

#, csharp-format
msgid "New account {0} {1} created in {2} is awaiting your approval."
msgstr "{2}에서 생성된 새 계정 {0} {1}이(가) 승인을 기다리고 있습니다."

msgid "Account awaiting approval"
msgstr "계정 승인 대기 중"

